        <tc:testCases>
            <tc:testCase id="_5772eafb-e623-4860-afa4-54d25b5f37a8" name="Test case 1" type="decisionService" invocableName="Whole Model Decision Service">
                <tc:inputNode name="gedurende de afgelopen twee jaar voor de huidige overtreding is er minimaal één maatregel bekendgemaakt vanwege het niet nakomen van de overige controlevoorschriften o.g.v. dezelfde wet">
                    <tc:value xsi:type="xsd:boolean">false</tc:value>
                </tc:inputNode>
                <tc:inputNode name="de persoon is in verband met zijn geestelijke toestand administratief onbekwaam">
                    <tc:value xsi:type="xsd:boolean">false</tc:value>
                </tc:inputNode>
                <tc:inputNode name="de administratieve onbekwaamheid betreft een kortstondige situatie">
                    <tc:value xsi:nil="true"/>
                </tc:inputNode>
                <tc:inputNode name="de buitengewone omstandigheid heeft geleid tot emotionele ontwrichting">
                    <tc:value xsi:type="xsd:boolean">false</tc:value>
                </tc:inputNode>
                <tc:inputNode name="de omstandigheid maakt nakomen verplichting feitelijk onmogelijk">
                    <tc:value xsi:nil="true"/>
                </tc:inputNode>
                <tc:inputNode name="de overtreding is door een samenstel van omstandigheden gedeeltelijk aan de persoon toe te rekenen">
                    <tc:value xsi:type="xsd:boolean">false</tc:value>
                </tc:inputNode>
                <tc:inputNode name="de SVB legt al een boetewaarschuwing op naar aanleiding van dezelfde gedraging">
                    <tc:value xsi:type="xsd:boolean">false</tc:value>
                </tc:inputNode>
                <tc:inputNode name="de SVB legt al een boete op naar aanleiding van dezelfde gedraging">
                    <tc:value xsi:type="xsd:boolean">false</tc:value>
                </tc:inputNode>
                <tc:inputNode name="een dringende reden is aanwezig">
                    <tc:value xsi:type="xsd:boolean">false</tc:value>
                </tc:inputNode>
                <tc:inputNode name="de persoon is een instelling">
                    <tc:value xsi:type="xsd:boolean">false</tc:value>
                </tc:inputNode>
                <tc:inputNode name="de uitkering waarop de maatregelsanctie kan worden ingehouden is beëindigd">
                    <tc:value xsi:type="xsd:boolean">false</tc:value>
                </tc:inputNode>
                <tc:inputNode name="de uitkering waarop de maatregelsanctie kan worden ingehouden kan herleven">
                    <tc:value xsi:nil="true"/>
                </tc:inputNode>
                <tc:inputNode name="de betaling van de uitkering is op verzoek van de persoon gestaakt">
                    <tc:value xsi:type="xsd:boolean">false</tc:value>
                </tc:inputNode>
                <tc:inputNode name="gedurende de afgelopen twee jaar voor de huidige overtreding is er minimaal één maatregelwaarschuwing bekendgemaakt o.g.v. dezelfde wet">
                    <tc:value xsi:type="xsd:boolean">false</tc:value>
                </tc:inputNode>
                <tc:inputNode name="gedurende de afgelopen twee jaar voor de huidige overtreding is er minimaal één maatregel bekendgemaakt vanwege het niet nakomen van een verplichting van de tweede categorie o.g.v. dezelfde wet">
                    <tc:value xsi:type="xsd:boolean">false</tc:value>
                </tc:inputNode>
                <tc:inputNode name="de SVB heeft al een schorsingsbeslissing genomen">
                    <tc:value xsi:type="xsd:boolean">true</tc:value>
                </tc:inputNode>
                <tc:inputNode name="de overtreding heeft geleid tot een benadelingsbedrag">
                    <tc:value xsi:type="xsd:boolean">false</tc:value>
                </tc:inputNode>
                <tc:inputNode name="de persoon is medewerkingsplichtig voor de AKW">
                    <tc:value xsi:type="xsd:boolean">true</tc:value>
                </tc:inputNode>
                <tc:inputNode name="er is sprake van een voorziene omstandigheid">
                    <tc:value xsi:nil="true"/>
                </tc:inputNode>
                <tc:inputNode name="er is sprake van een gewenste omstandigheid">
                    <tc:value xsi:nil="true"/>
                </tc:inputNode>
                <tc:inputNode name="de omstandigheid behoort tot het normale levenspatroon van de persoon">
                    <tc:value xsi:type="xsd:boolean">true</tc:value>
                </tc:inputNode>
                <tc:inputNode name="de overtreding van de mededelingsverplichting of de hoogte van het benadelingsbedrag is mede te wijten aan de SVB">
                    <tc:value xsi:type="xsd:boolean">false</tc:value>
                </tc:inputNode>
                <tc:inputNode name="er is sprake van een omstandigheid die expliciet wordt genoemd in het beleid als voorbeeld van omstandigheden waarbij emotionele ontwrichting wordt aangenomen">
                    <tc:value xsi:type="xsd:string">andere reden</tc:value>
                </tc:inputNode>
                <tc:inputNode name="de persoon heeft de inlichtingen verstrekt in het kader van een controle van de SVB">
                    <tc:value xsi:type="xsd:boolean">true</tc:value>
                </tc:inputNode>
                <tc:inputNode name="de persoon heeft een wijziging van omstandigheden te laat gemeld maar heeft uit eigen beweging alsnog de juiste inlichtingen verstrekt voordat de overtreding is geconstateerd">
                    <tc:value xsi:nil="true"/>
                </tc:inputNode>
                <tc:inputNode name="de persoon heeft inlichtingen verstrekt die onvolledig waren maar uit eigen beweging alsnog de juiste inlichtingen verstrekt voordat de overtreding is geconstateerd">
                    <tc:value xsi:nil="true"/>
                </tc:inputNode>
                <tc:inputNode name="de persoon heeft inlichtingen verstrekt die onjuist waren maar uit eigen beweging alsnog de juiste inlichtingen verstrekt voordat de overtreding is geconstateerd">
                    <tc:value xsi:type="xsd:boolean">true</tc:value>
                </tc:inputNode>
                <tc:inputNode name="de soort verplichting die de persoon heeft overtreden">
                    <tc:value xsi:type="xsd:string">reageren op een informatieverzoek</tc:value>
                </tc:inputNode>
                <tc:inputNode name="gedurende de afgelopen twee jaar voor de huidige overtreding is er minimaal één maatregel o.g.v. dezelfde wet bekendgemaakt vanwege het niet reageren op een informatieverzoek">
                    <tc:value xsi:type="xsd:boolean">false</tc:value>
                </tc:inputNode>
                <tc:inputNode name="gedurende de afgelopen twee jaar voor de huidige overtreding is er minimaal één maatregel o.g.v. dezelfde wet bekendgemaakt vanwege het niet tijdig reageren op een informatieverzoek">
                    <tc:value xsi:type="xsd:boolean">false</tc:value>
                </tc:inputNode>
                <tc:inputNode name="de persoon heeft binnen vier weken nadat zich een omstandigheid heeft voorgedaan die hij had moeten melden aan de SVB bericht van de SVB ontvangen waaruit hij kan afleiden dat de SVB al van de wijziging op de hoogte is">
                    <tc:value xsi:type="xsd:boolean">false</tc:value>
                </tc:inputNode>
                <tc:inputNode name="de persoon heeft de verhuizing buitenland die uit eigen beweging moet worden gemeld alsnog tijdig gemeld naar aanleiding van een informatieverzoek SVB">
                    <tc:value xsi:nil="true"/>
                </tc:inputNode>
                <tc:inputNode name="er is sprake van een verhuizing buitenland die uit eigen beweging moet worden gemeld">
                    <tc:value xsi:type="xsd:boolean">false</tc:value>
                </tc:inputNode>
                <tc:inputNode name="de SVB heeft informatie gevraagd in het kader van een bezwaarprocedure">
                    <tc:value xsi:type="xsd:boolean">false</tc:value>
                </tc:inputNode>
                <tc:inputNode name="de SVB heeft informatie opgevraagd over inhoudingen loonheffing Zorgverzekeringswet of inhoudingen Wlz">
                    <tc:value xsi:type="xsd:boolean">false</tc:value>
                </tc:inputNode>
                <tc:inputNode name="de verplichting AKW die de persoon heeft overtreden">
                    <tc:value xsi:type="xsd:string">Een wijziging in het adres van de niet in de BRP ingeschreven kinderbijslaggerechtigde onverwijld melden</tc:value>
                </tc:inputNode>
                <tc:inputNode name="de kinderen">
                    <tc:list>
                        <tc:item>
                            <tc:component name="de geboortedatum van het kind">
                                <tc:value xsi:type="xsd:date">2016-03-25</tc:value>
                            </tc:component>
                        </tc:item>
                        <tc:item>
                            <tc:component name="de geboortedatum van het kind">
                                <tc:value xsi:type="xsd:date">2018-04-01</tc:value>
                            </tc:component>
                        </tc:item>
                    </tc:list>
                </tc:inputNode>
                <tc:inputNode name="de beoordelingsdatum">
                    <tc:value xsi:type="xsd:date">2026-09-22</tc:value>
                </tc:inputNode>
                <tc:resultNode id="_1a0abf2b-b8a7-4244-9df5-87dd0feb5ece" name="het type de duur en de hoogte van de maatregelsanctie">
                    <tc:expected>
                        <tc:value xsi:type="xsd:string">maatregel eerste categorie ter hoogte van 5% van het In aanmerking te nemen uitkeringsbedrag gedurende één uitkeringstermijn</tc:value>
                    </tc:expected>
                </tc:resultNode>
            </tc:testCase>
        </tc:testCases>
        <triso:notes>&lt;p&gt;&lt;strong&gt;Challenges&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;/ul&gt;</triso:notes>
