        <semantic:decisionTable triso:descriptionVisible="false" id="_bb8a6c18-8b94-481f-8ebe-175e13da173a" hitPolicy="UNIQUE" outputLabel="overtreden soort verplichting AKW" typeRef="Tovertredensoortverplichtingalgemeen" triso:expressionId="_8de99b40-1605-4e6a-9b4e-8f803a63e8d5">
